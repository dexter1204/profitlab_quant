# Copy to .streamlit/secrets.toml locally (git-ignored) OR paste these into
# Streamlit Community Cloud → App settings → Secrets.
#
# When present, dashboard/app.py copies them into os.environ before the
# sidebar controls initialize, so the deployed app runs against your
# real vendor without the user having to paste keys each session.

PROFITLAB_VENDOR = "yfinance"          # or "polygon" / "polygon_mcp"

# Only needed if PROFITLAB_VENDOR = "polygon"
POLYGON_API_KEY = ""
POLYGON_BASE_URL = "https://api.polygon.io"

# Only needed if PROFITLAB_VENDOR = "polygon_mcp"
POLYGON_MCP_URL = "https://prod.api.market/api/mcp/polygon.io/polygon"
POLYGON_MCP_KEY = ""
